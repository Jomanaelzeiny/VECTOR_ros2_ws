<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vector_twin_tools</name>
  <version>0.0.2</version>
  <description>VECTOR digital twin ROS2 tools: fake camera publisher, twin pose listener, manual control</description>
  <maintainer email="jomana@todo.todo">jomana</maintainer>
  <license>TODO</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>  <!-- CHANGED: needed for /f1r3/mode (std_msgs/String) -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>