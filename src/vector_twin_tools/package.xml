<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vector_twin_tools</name>
  <version>0.0.4</version>  <!-- CHANGED -->
  <description>VECTOR digital twin ROS2 tools: fake camera publisher, twin pose listener, manual control, fake car serial, serial bridge</description>  <!-- CHANGED -->
  <maintainer email="jomana@todo.todo">jomana</maintainer>
  <license>TODO</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
